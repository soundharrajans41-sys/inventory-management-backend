# ========================================================
# Spring Boot Backend Environment Variables Template
# Copy this file to .env and fill in the values for deployment.
# ========================================================

SERVER_PORT=8080

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/inventory_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=

# Security / JWT (Provide a 256-bit secret key)
JWT_SECRET=
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hibernate DDL Mode (update / validate / none)
JPA_DDL_AUTO=update
